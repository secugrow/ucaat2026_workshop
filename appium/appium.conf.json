{
  "server": {
    "port": 4723,
    "allow-cors": true,
    "use-plugins": ["devtools"],
    "plugin": {
      "devtools": {}
    },
    "allow-insecure": ["chromedriver_autodownload", "adb_shell"],
    "relaxed-security": true,
    "driver": {
      "uiautomator2": {
        "chromedriver-executable-dir": "${HOME}/chromedrivers",
        "chromedriverStorageDir": "${HOME}/chromedrivers"
      }
    }
  }
}
